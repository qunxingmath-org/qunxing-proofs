{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.qunxingmath.org/schema/qunxing.submission-1.schema.json",
  "title": "证明提交清单（qunxing.yaml）/ Proof submission manifest",
  "description": "第一步\"提交证明，点亮星星\"的清单，放在提交目录的 qunxing.yaml（同意范围 submission）。会公开。不含 token、金额、时间、GitHub 编号、邮箱和本机路径：用户 2026-11-23 决定证明和科研数据分开上传；提交者身份只存在服务器（submitter_key），不进公开文件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "consent_version",
    "problem_id",
    "card_rev",
    "statement",
    "claim",
    "toolchain",
    "mathlib_rev",
    "records",
    "disclosure",
    "license",
    "destinations"
  ],
  "properties": {
    "schema": {
      "const": "qunxing.submission/1"
    },
    "consent_version": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[01][0-9]-v[0-9]+$",
      "description": "同意文案的版本，如 2026-11-v5 / version of the consent text"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^QX-P-[0-9]{6}$",
      "description": "群星题号 / problem id"
    },
    "card_rev": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "challenge_sha256",
        "review"
      ],
      "properties": {
        "source": {
          "enum": [
            "locked",
            "self"
          ],
          "description": "locked：用题卡锁定的 Challenge；self：本次自己写的（星星带\"题面未锁定\"）"
        },
        "challenge_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Challenge.lean 的 sha256；还没写 Lean 时为 null"
        },
        "review": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vendor",
                "model",
                "verdict",
                "verdict_sha256"
              ],
              "properties": {
                "vendor": {
                  "enum": [
                    "openai",
                    "anthropic",
                    "google",
                    "deepseek",
                    "moonshot",
                    "alibaba",
                    "zhipu",
                    "xai",
                    "other"
                  ]
                },
                "model": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                  "description": "价格表里的模型名；价格表里没有的一律写 other，不上传自定义名称 / model name from the price table, else other"
                },
                "verdict": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INCONCLUSIVE"
                  ]
                },
                "verdict_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "records/verdicts/ 下那份 qunxing.verdict/1 的 sha256"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "题意复核：结论和用的模型；没做为 null"
        }
      },
      "description": "题面"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "stage",
        "revision",
        "theorem_names",
        "definition_names"
      ],
      "properties": {
        "kind": {
          "enum": [
            "proof",
            "disproof",
            "partial",
            "value"
          ]
        },
        "stage": {
          "enum": [
            "solved_claimed",
            "formal_local",
            "statement_ok"
          ],
          "description": "达到的阶段：解出 / Lean 通过 / 题意通过"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "同一次运行的第几版提交；升级阶段时加 1，原地更新"
        },
        "theorem_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.']{0,199}$"
          }
        },
        "definition_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.']{0,199}$"
          }
        }
      },
      "description": "主张"
    },
    "toolchain": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(-rc[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mathlib_rev": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "run_ref"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "records/MANIFEST.sha256 的 sha256"
        },
        "run_ref": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "HMAC-SHA256(本机密钥, \"qunxing.submission:\" + run_id) 的前 16 位。与科研数据的 run_ref 用不同标签算，两边对不上"
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendors",
        "models",
        "harness"
      ],
      "properties": {
        "vendors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "openai",
              "anthropic",
              "google",
              "deepseek",
              "moonshot",
              "alibaba",
              "zhipu",
              "xai",
              "other"
            ]
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "description": "价格表里的模型名；价格表里没有的一律写 other，不上传自定义名称 / model name from the price table, else other"
          }
        },
        "harness": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "claude-code",
              "gemini-cli",
              "kimi-cli",
              "qwen-code",
              "opencode",
              "other"
            ]
          }
        }
      },
      "description": "用了哪些模型和工具（研究守则第 8 条）"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "text"
      ],
      "properties": {
        "code": {
          "const": "Apache-2.0"
        },
        "text": {
          "const": "CC-BY-SA-4.0"
        }
      },
      "description": "Lean 代码和文字的许可"
    },
    "destinations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "own_repo"
      ],
      "properties": {
        "dataset": {
          "type": "boolean",
          "description": "群星公开数据集（qunxing-proofs）"
        },
        "own_repo": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repo",
                "path"
              ],
              "properties": {
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$"
                },
                "path": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9._/-]*$",
                  "not": {
                    "pattern": "(^/|^~|[A-Za-z]:[\\\\/]|/home/|/Users/|\\\\Users\\\\|\\.\\.)"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "用户自己的 GitHub 仓库（装了群星的那一个）和写入目录"
        }
      },
      "description": "提交到哪里，可以都选"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {
              "stage": {
                "enum": [
                  "formal_local",
                  "statement_ok"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "toolchain": {
            "type": "string",
            "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(-rc[0-9]+)?$"
          },
          "mathlib_rev": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "statement": {
            "properties": {
              "challenge_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim": {
            "properties": {
              "stage": {
                "const": "statement_ok"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "statement": {
            "properties": {
              "review": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "destinations": {
          "anyOf": [
            {
              "properties": {
                "dataset": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "own_repo": {
                  "type": "object"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
